services:
  vaultwarden:
    image: vaultwarden/server:latest
    container_name: vaultwarden
    restart: unless-stopped
    networks:
      - proxy
    volumes:
      - ./data:/data
    environment:
      - DOMAIN=https://vaultwarden.wonder.lan
      - SIGNUPS_ALLOWED=true    # disable after creating the needed accounts and restart
      - ADMIN_TOKEN=${ADMIN_TOKEN}

networks:
  proxy:
    external: true
