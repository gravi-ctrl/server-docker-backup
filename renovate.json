
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "local>gravi-ctrl/server-docker-backup//renovate-feed/n8n-stable"
  ],
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions"
  ],
  "ignorePaths": [
    "_archive/**"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 5,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Disable release-age requirement for Docker digest updates only.",
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "One PR per stack, with the stack name in branch and title",
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "additionalBranchPrefix": "{{parentDir}}-",
      "commitMessagePrefix": "[{{parentDir}}]"
    },
    {
      "description": "Major updates require manual review and seven days.",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "7 days",
      "labels": [
        "major-update",
        "review-carefully"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "lscr.io/linuxserver/qbittorrent"
      ],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Auto-merge Docker digest and patch updates, excluding critical services.",
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "patch"
      ],
      "matchPackageNames": [
        "!nextcloud",
        "!**/nextcloud",
        "!mariadb",
        "!**/mariadb",
        "!postgres",
        "!**/postgres",
        "!n8nio/n8n",
        "!pocket-id",
        "!**/pocket-id"
      ],
      "automerge": true,
      "addLabels": [
        "automerge"
      ]
    },
    {
      "description": "Explicitly keep critical services manual: Nextcloud, databases, n8n and Pocket ID.",
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "nextcloud",
        "**/nextcloud",
        "mariadb",
        "**/mariadb",
        "postgres",
        "**/postgres",
        "n8nio/n8n",
        "pocket-id",
        "**/pocket-id"
      ],
      "automerge": false
    }
  ],
  "timezone": "Africa/Cairo",
  "platformAutomerge": false,
  "automergeSchedule": [
    "after 6am and before 11am"
  ]
}
