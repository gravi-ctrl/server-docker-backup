{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "local>gravi-ctrl/server-docker-backup//renovate-feed/n8n-stable"
  ],
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions"
  ],
  "ignorePaths": [
    "_archive/**"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 5,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Disable release-age requirement for Docker digest updates only.",
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "One PR per stack, with the stack name in branch and title",
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "additionalBranchPrefix": "{{parentDir}}-",
      "commitMessagePrefix": "[{{parentDir}}]"
    },
    {
      "description": "Major updates require manual review and seven days.",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "7 days",
      "labels": [
        "major-update",
        "review-carefully"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "lscr.io/linuxserver/qbittorrent"
      ],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Auto-merge Docker digest and patch updates. Services that must stay manual are listed in the rule below, which overrides this one because it comes later.",
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "patch"
      ],
      "automerge": true,
      "addLabels": [
        "automerge"
      ]
    },
    {
      "description": "Single source of truth for services that must never automerge: Nextcloud, databases and datastores, n8n and Pocket ID. Keep this rule AFTER the automerge rule, later rules win.",
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "nextcloud",
        "**/nextcloud",
        "mariadb",
        "**/mariadb",
        "postgres",
        "**/postgres",
        "**/pgvector",
        "mysql",
        "**/mysql",
        "mongo",
        "**/mongo",
        "redis",
        "**/redis",
        "valkey",
        "**/valkey",
        "n8nio/n8n",
        "pocket-id"
        "**/pocket-id",
        "uptime-kuma",
        "**/uptime-kuma",
        "romm",
        "**/romm"
      ],
      "automerge": false
    },
    {
      "description": [
        "BLOCKLIST for versions that failed gitops verification and were reverted. Without this, Renovate re-opens the PR for the same version after the revert and automerge would deploy it again.",
        "To use: put the image name in matchPackageNames and the bad tag(s) in the regex, e.g. \"!/^(?:1\\\\.2\\\\.3|1\\\\.2\\\\.4)$/\" blocks 1.2.3 and 1.2.4. Dots are escaped as \\\\. inside JSON.",
        "Remove the entry once a fixed version is out. The placeholder below matches nothing, so the rule is inert until filled."
      ],
      "matchPackageNames": [
        "REPLACE/with-image-name"
      ],
      "allowedVersions": "!/^(?:REPLACE-ME)$/"
    }
  ],
  "timezone": "Africa/Cairo",
  "platformAutomerge": false,
  "automergeSchedule": [
    "after 6am and before 11am"
  ]
}
