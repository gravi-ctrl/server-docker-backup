# ==============================================================================
# 1. IGNORE EVERYTHING BY DEFAULT
# ==============================================================================
*

# Allow Git to traverse directory structures
!*/

# ==============================================================================
# 2. RUNTIME & HEAVY DATA DIRECTORIES (Prevent Permission Errors & Slowness)
# ==============================================================================
**/config/
**/data/
**/n8n_data/
**/metadata/
**/db/
**/postgres/
**/pgdata/
**/mysql_data/
**/influxdb/
**/html/
**/letsencrypt/
**/etc-pihole/
**/etc-dnsmasq.d/
**/custom-tessdata/

# ==============================================================================
# 3. BASE ALLOW RULES
# ==============================================================================
# Compose files
!compose.yml
!compose.yaml
!compose.yml.disabled
!docker-compose.yml
!docker-compose.yaml
!compose.yaml.disabled

# Repo & Environment Metadata
!Dockerfile
!.github/workflows/*.yml
!.gitignore
!.gitattributes
!.git-perms
!.commit-warning
!.env.example
!/README.md
!renovate.json

# ==============================================================================
# 4. CONTAINER CONFIG EXCEPTIONS
# ==============================================================================
# Renovate
!renovate/config.js

# Homepage Dashboard Configs & Icons
!homepage/config/
!homepage/config/*.yaml
!homepage/config/*.yml
!homepage/config/*.css
!homepage/config/*.js
!homepage/config/images/
!homepage/config/images/*

# LinuxServer / Container Custom Init Scripts
!**/custom-cont-init.d/
!**/custom-cont-init.d/*

# Paperless Non-Secret Config
!paperless-ngx/docker-compose.env

# Pihole update script
!pihole/*.sh

# n8n OIDC fix script
!n8n/n8n-oidc-check.sh

# Nextcloud scripts
!nextcloud/*.sh

# Wifi Robot Custom App
!wifi-robot/*.py
!wifi-robot/guestwifi
!wifi-robot/*.txt

# ==============================================================================
# 5. STRICT SECURITY EXCLUSIONS
# ==============================================================================
.env
**/.env
.git/
*.log
